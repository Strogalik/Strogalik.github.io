{
  "name": "tms-business-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "audit": "node scripts/lighthouse.mjs",
    "prebuild": "node scripts/prepare-fonts.mjs",
    "predev": "node scripts/prepare-fonts.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@glass-sdk/liquid-glass": "0.0.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
